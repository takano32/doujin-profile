<?xml version="1.0" encoding="UTF-8"?>
<!--
結合試験: さくらの $HOME/doujin-profile-test/wp/ (使い捨ての WordPress。DB は SQLite) に本体を入れて、
フック・REST・WP-CLI・ブロックの描画を本物の WordPress で確かめる。実行は scripts/test.sh integration
(tests/remote/integration.sh が WordPress を用意して、環境変数 DOUJIN_PROFILE_WP を渡す)。
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         convertDeprecationsToExceptions="false"
         cacheResult="false">
	<testsuites>
		<testsuite name="integration">
			<directory>.</directory>
		</testsuite>
	</testsuites>
	<php>
		<ini name="error_reporting" value="-1"/>
	</php>
</phpunit>
